clear; clc; close all;

%% params and gains
p = struct();

p.l1 = 0.22; % m thigh
p.l2 = 0.22; % m crus

p.r = 0.04; % m wheel radius
p.l_Tw = 0.12;

% task-space PD gains (6x6)
p.Kp_task = diag([50.0, 0.0, 20.0, 20.0, 35.0, 0.0]);
p.Kd_task = diag([0.5, 0.0, 5.0, 5.0, 10.0, 0.0]);

% joint-space "position control -> acceleration" gains
p.Kp_j = [30; 30; 30];
p.Kd_j = [25;  25;  25];

%% prova
p.l_Th = 0.12;

p.pH_T = [0; p.l_Th/2];

%% initial conditions
qL0 = [0; 0; 0];
qR0 = [0; 0; 0];
dqL0 = [0; 0; 0];
dqR0 = [0; 0; 0];
v0 = 0;

qLstar0 = qL0;
qRstar0 = qR0;

% x0 = [qL0; dqL0; qR0; dqR0; qLstar0; qRstar0];
x0 = [qL0; qLd0; qR0; qRd0; v0; qLstar0; qRstar0];

%% task
hip_l0 = leg_fk(qL0, p);
hip_r0 = leg_fk(qR0, p);
task0 = task_from_hips(hip_l0, hip_r0);
z0 = task0(2);
d0 = task0(3);
beta0 = task0(4);

traj.chi_star = @(t) [1.5*sin(0.2*pi*t); 0; z0; d0; beta0; 0];
traj.dchi_star = @(t) [1.5*0.2*pi*cos(0.2*pi*t); 0; 0; 0; 0; 0];

%% ode45
tspan = [0 10];
opts = odeset('RelTol', 1e-6,'AbsTol', 1e-8);

fprintf('Running ode45...\n');
[t,X] = ode45(@(t,x) robot_ode(t,x,p,traj), tspan, x0, opts);
fprintf('Done. Steps: %d, t_end: %.3f s\n', numel(t), t(end));

%% prints
qL = X(:,1:3);
qR = X(:,7:9);

v = X(:,13);
qL_star = X(:,14:16);
qR_star = X(:,17:19);

% qL_star = X(:,13:15);
% qR_star = X(:,16:18);
%
% for k = 1:numel(t)
%     qLk = X(k,1:3)';
%     qRk = X(k,7:9)';
%     dqLk = X(k,4:6)';
%     dqRk = X(k,10:12)';
% 
%     WBJ = compute_WBJ(qLk, qRk, p);
%     qdot = [dqLk; dqRk];
%     dq_com = WBJ * qdot; 
% 
%     v(k) = dq_com(1);
%     % v(k) = -([0.02, 0, 0]*dqLk + [0.02, 0, 0]*dqRk);
% end

fprintf('\nFinal values:\n');
fprintf('  v(end)      = %.4f\n', v(end));
fprintf('  qL(end)     = [% .3f % .3f % .3f]\n', qL(end,1), qL(end,2), qL(end,3));
fprintf('  qL_star(end)= [% .3f % .3f % .3f]\n', qL_star(end,1), qL_star(end,2), qL_star(end,3));
fprintf('  qR(end)     = [% .3f % .3f % .3f]\n', qR(end,1), qR(end,2), qR(end,3));
fprintf('  qR_star(end)= [% .3f % .3f % .3f]\n', qR_star(end,1), qR_star(end,2), qR_star(end,3));

% post processing for analysis
supportWidth = p.l_Tw; % wheel-to-wheel distance [m]
margin = 0.02; % safety margin [m]
g = 9.81;

chi = zeros(numel(t),6);
chi_star = zeros(numel(t),6);
dchi = zeros(numel(t),6);
dchi_star = zeros(numel(t),6);
xcom = zeros(numel(t),1);
zcom = zeros(numel(t),1);

for k = 1:numel(t)
    qLk = qL(k,:)';
    qRk = qR(k,:)';
    dqLk = X(k,4:6)';
    dqRk = X(k,10:12)';
    vk = v(k);

    hip_l = leg_fk(qLk, p);
    hip_r = leg_fk(qRk, p);
    task  = task_from_hips(hip_l, hip_r);

    xcom(k) = task(1);
    zcom(k) = task(2);

    chi(k,:) = [vk; 0; task(2); task(3); task(4); 0]';
    chi_star(k,:) = traj.chi_star(t(k))';

    %% prova
    l1 = p.l1; l2 = p.l2;
    beta = task(4);
    R = [ cos(beta), -sin(beta);
      sin(beta),  cos(beta)];

    pCOM_W = [task(1); task(2)];
    pH_W   = pCOM_W + R * p.pH_T;

    th1L = beta + qL(1);
    th2L = beta + qL(1) + qL(2);
    
    th1R = beta + qR(1);
    th2R = beta + qR(1) + qR(2);
    
    pHW_L = [ l1*sin(th1L) + l2*sin(th2L);
             -l1*cos(th1L) - l2*cos(th2L) ];
    
    pHW_R = [ l1*sin(th1R) + l2*sin(th2R);
             -l1*cos(th1R) - l2*cos(th2R) ];
    
    pWheel_L_W = pH_W + pHW_L;
    pWheel_R_W = pH_W + pHW_R;
    
    xWheel_L = pWheel_L_W(1);
    xWheel_R = pWheel_R_W(1);
    %%

    WBJ = compute_WBJ(qLk, qRk, p);
    qdot = [dqLk; dqRk];
    dchi(k,:) = WBJ * qdot;
    % dchi(k,1)= 9.81 * (task(1)-xWheel_L) / task(2);
    dchi(k,1)= 9.81 * task(1) / task(2);

    dchi_star(k,:) = traj.dchi_star(t(k))';
end

xcom_dot = v(:);

omega = sqrt(g ./ max(zcom, 0.05));
xcp = xcom + xcom_dot ./ omega;

balanced_cp = abs(xcp) <= (supportWidth/2 - margin);

fprintf('\nChi tracking (end):\n');
fprintf('  chi(end)      = [% .3f % .3f % .3f % .3f % .3f % .3f]\n', chi(end,:));
fprintf('  chi_star(end) = [% .3f % .3f % .3f % .3f % .3f % .3f]\n', chi_star(end,:));

figure; plot(t, chi_star(:,1), '--', t, chi(:,1), '-'); grid on;
xlabel('t [s]'); ylabel('v'); legend('v^*','v');

figure; plot(t, dchi_star(:,1), '--', t, dchi(:,1), '-'); grid on;
xlabel('t [s]'); ylabel('dv'); legend('dv^*','dv');

figure; plot(t, chi_star(:,3), '--', t, chi(:,3), '-'); grid on;
xlabel('t [s]'); ylabel('z'); legend('z^*','z');

figure; plot(t, chi_star(:,4), '--', t, chi(:,4), '-'); grid on;
xlabel('t [s]'); ylabel('d'); legend('d^*','d');

figure; plot(t, chi_star(:,5), '--', t, chi(:,5), '-'); grid on;
xlabel('t [s]'); ylabel('\beta'); legend('\beta^*','\beta');

figure; plot(t, qL_star, '--'); hold on; plot(t, qL, '-'); grid on;
xlabel('t [s]'); ylabel('Left leg joints'); legend('qL1^*','qL2^*','qL3^*','qL1','qL2','qL3');

figure; plot(t, qR_star, '--'); hold on; plot(t, qR, '-'); grid on;
xlabel('t [s]'); ylabel('Right leg joints'); legend('qR1^*','qR2^*','qR3^*','qR1','qR2','qR3');

% State: x = [qL(3); qLd(3); qR(3); qRd(3); qL*(3); qR*(3)]
function xdot = robot_ode(t, x, p, traj)
    % recover data form x
    i = 0;
    qL = x(i+1:i+3); i=i+3;
    qLd = x(i+1:i+3); i=i+3;
    qR = x(i+1:i+3); i=i+3;
    qRd = x(i+1:i+3); i=i+3;
    v = x(i+1); i=i+1;
    qL_star = x(i+1:i+3); i=i+3;
    qR_star = x(i+1:i+3);
    
    % task from current joints
    hip_l = leg_fk(qL, p);
    hip_r = leg_fk(qR, p);
    task = task_from_hips(hip_l, hip_r);  % [xcom; zcom; d; beta]

    %% prova
    l1 = p.l1; l2 = p.l2;
    beta = task(4);
    R = [ cos(beta), -sin(beta);
      sin(beta),  cos(beta)];

    pCOM_W = [task(1); task(2)];
    pH_W   = pCOM_W + R * p.pH_T;

    th1L = beta + qL(1);
    th2L = beta + qL(1) + qL(2);
    
    th1R = beta + qR(1);
    th2R = beta + qR(1) + qR(2);
    
    pHW_L = [ l1*sin(th1L) + l2*sin(th2L);
             -l1*cos(th1L) - l2*cos(th2L) ];
    
    pHW_R = [ l1*sin(th1R) + l2*sin(th2R);
             -l1*cos(th1R) - l2*cos(th2R) ];
    
    pWheel_L_W = pH_W + pHW_L;
    pWheel_R_W = pH_W + pHW_R;
    
    xWheel_L = pWheel_L_W(1);
    xWheel_R = pWheel_R_W(1);
    % fprintf("x_com = %f   x_wL = %f   x_wR = %f\n", task(1), xWheel_L, xWheel_R);
    fprintf("x_com = %f   z_com = %f\n", task(1), task(2));
    %%

    WBJ = compute_WBJ(qL, qR, p);
    qdot = [qLd; qRd];
    dchi = WBJ * qdot; % not dchi yet, first element is dx_com 

    % v = dchi(1);
    % v = -([0.02, 0, 0]*qLd + [0.02, 0, 0]*qRd);

    % dchi(1) = 9.81 * (task(1)-xWheel_L) / task(2); % now is dchi (from LIPM: xdd = g/z * xcom)
    dchi(1) = 9.81 * task(1) / task(2);

    chi = [v; 0; task(2); task(3); task(4); 0]; % [v; 0; zcom; d; beta; 0]
    
    % current desired task trajectory
    chi_star = traj.chi_star(t);
    dchi_star = traj.dchi_star(t);

    % task-space controller (Eq. 11)
    % dq_hat_com = Kp(chi* - chi) + Kd(dchi* - dchi)
    dq_hat_com = p.Kp_task*(chi_star - chi) + p.Kd_task*(dchi_star - dchi);
    
    % WBJ mapping (Eq. 8-9)
    WBJ = compute_WBJ(qL, qR, p); % Eq. (9)
    lambda = 1e-2; 
    dq_star = (WBJ.'*WBJ + lambda^2*eye(size(WBJ,2))) \ (WBJ.'*dq_hat_com); % Eq. (8) qdot_hat_com = WBJ * [qdot_L; qdot_R]
    % dq_star = pinv(WBJ)*dq_hat_com;

    % for desired joint angles (Eq. 12) and joint position control
    dqL_star = dq_star(1:3);
    dqR_star = dq_star(4:6);
    
    % joint "position control -> acceleration" qdd = Kp(q* - q) - Kd (dq* - dq)
    qLdd = p.Kp_j .* (qL_star - qL) + p.Kd_j .* (dqL_star - qLd);
    qRdd = p.Kp_j .* (qR_star - qR) + p.Kd_j .* (dqR_star - qRd);

    % xdot = [qLd; qLdd; qRd; qRdd; dqL_star; dqR_star];
    xdot = [qLd; qLdd; qRd; qRdd; dqL_star; dqR_star];
end

xbase = cumtrapz(t, v(:)); % x position over time
xbase = xbase - xbase(1);

